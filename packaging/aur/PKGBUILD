# Maintainer: theesfeld
# f00tils — freestanding ASM multicall (coreutils+grep+findutils+diffutils)
#
# Bare names install to /usr/bin (ls, find, grep, diff, … → f00).
# This package CONFLICTS with GNU packages and PROVIDES them — same model as
# replacing coreutils: every session (TTY, SSH, non-login) just works.
# No PATH tricks required for the distro package.
#
# Side-by-side with GNU: do not install this package; use curl install
# F00_SUPERSEDE=0 or only invoke f00-*.
#
# If upgrade fails with "exists in filesystem":
#   sudo scripts/arch-clean-unowned-f00.sh
pkgname=f00
pkgver=0.16.10
pkgrel=1
pkgdesc="f00tils — freestanding ASM multicall (replaces coreutils+grep+findutils+diffutils)"
arch=('x86_64')
url="https://coreutils.f00.sh"
license=('MIT')
depends=()
# Own /usr/bin/find ls grep diff … — every session, zero PATH games
provides=('coreutils' 'findutils' 'grep' 'diffutils')
conflicts=('coreutils' 'findutils' 'grep' 'diffutils')
replaces=('coreutils' 'findutils' 'grep' 'diffutils')
options=('!strip')
source=("https://github.com/theesfeld/f00tils/releases/download/v${pkgver}/f00-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  local root
  root="${srcdir}/f00-${pkgver}-linux-x86_64"
  if [[ ! -d "${root}" ]]; then
    root="${srcdir}/f00-${pkgver}-x86_64-linux"
  fi
  if [[ ! -d "${root}" ]]; then
    root="$(dirname "$(find "${srcdir}" -type f -name f00 | head -n1)")"
  fi
  install -Dm755 "${root}/f00" "${pkgdir}/usr/bin/f00"

  # Shell helpers still useful for curl/~/.local side installs on the same machine
  mkdir -p "${pkgdir}/usr/lib/f00/shell"
  if [[ -f "${root}/share/f00/path.sh" ]]; then
    install -Dm644 "${root}/share/f00/path.sh" "${pkgdir}/usr/lib/f00/shell/path.sh"
  fi
  if [[ -f "${root}/share/f00/f00.sh" ]]; then
    install -Dm644 "${root}/share/f00/f00.sh" "${pkgdir}/etc/profile.d/f00.sh"
  fi
  if [[ -f "${root}/share/f00/zshenv" ]]; then
    install -Dm644 "${root}/share/f00/zshenv" "${pkgdir}/etc/zsh/zshenv"
  fi
  if [[ -f "${root}/share/f00/f00.fish" ]]; then
    install -Dm644 "${root}/share/f00/f00.fish" "${pkgdir}/etc/fish/conf.d/f00.fish"
  fi

  local u
  for u in ls cat true false yes nproc tty whoami basename dirname \
           head tail wc tee seq echo pwd sleep \
           env printenv realpath readlink pathchk mktemp link unlink sync truncate \
           mkdir rmdir chmod touch logname hostid \
           cut tr sort uniq rev tac nl fold expand unexpand paste join comm fmt od \
           split csplit shuf tsort pr ptx factor numfmt expr \
           cp mv rm ln chown chgrp stat df du install mkfifo mknod shred dd dir vdir \
           id groups uname arch date users who pinky uptime hostname \
           nice nohup timeout kill test printf \
           md5sum sha1sum sha256sum sha224sum sha384sum sha512sum b2sum cksum sum \
           base64 basenc base32 dircolors chroot stty stdbuf runcon chcon config \
           grep egrep fgrep find xargs diff cmp diff3 sdiff; do
    ln -s f00 "${pkgdir}/usr/bin/f00-${u}"
    ln -s f00 "${pkgdir}/usr/bin/${u}"
  done
  ln -s f00 "${pkgdir}/usr/bin/f00-["
  ln -s f00 "${pkgdir}/usr/bin/["

  if [[ -f "${root}/LICENSE" ]]; then
    install -Dm644 "${root}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  fi
  if [[ -d "${root}/man/man1" ]]; then
    install -Dm644 "${root}/man/man1/"*.1 -t "${pkgdir}/usr/share/man/man1/"
  fi
}
