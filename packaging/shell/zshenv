# f00tils — zsh helper for user installs (~/.local/bin on PATH).
# Distro package puts bare names in /usr/bin (conflicts with GNU) — no PATH needed.
# Toggle user PATH helper: replace = false in ~/.config/f00/config

if [[ -r /usr/lib/f00/shell/path.sh ]]; then
  emulate sh -c 'source /usr/lib/f00/shell/path.sh'
fi
